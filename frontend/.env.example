# Optional in development; when unset, Vite uses http://127.0.0.1:5000/api.
# Vite embeds this value at build time. It must never contain secrets.
# VITE_API_BASE_URL=http://127.0.0.1:5000/api

# Production examples (choose the one matching the deployment routing):
# VITE_API_BASE_URL=/api
# VITE_API_BASE_URL=https://api.example.com/api

