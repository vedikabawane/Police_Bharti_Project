DATABASE_URL=
JWT_SECRET_KEY=

# APP_DEBUG is opt-in and is ignored when APP_ENV=production.
APP_ENV=development
APP_DEBUG=false
# Application log level. Defaults to DEBUG in development and INFO elsewhere.
# DEBUG is reduced to INFO in production.
LOG_LEVEL=DEBUG

# Leave blank to enable Swagger outside production and disable it in production.
# Set true only when the interactive API docs are intentionally exposed.
SWAGGER_ENABLED=

# Number of trusted reverse-proxy hops. Keep at 0 unless the deployment is
# behind a known proxy chain configured by the operator.
TRUSTED_PROXY_HOPS=0

# Development defaults are the two local Vite origins. Set explicit frontend
# origins in production; wildcard origins are rejected.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Defaults to backend/uploads. Mount a persistent volume here in production.
UPLOAD_ROOT=

# Email is disabled by default. Configure the SMTP values on the server only.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_FROM=
MAIL_TIMEOUT=10

# SMS is disabled by default. `mock` is for local development/tests only;
# a real provider adapter and its provider-specific settings are not selected yet.
SMS_ENABLED=false
SMS_PROVIDER=
SMS_REQUEST_TIMEOUT=5
SMS_MAX_ATTEMPTS=3

# Registration uses the original direct account-creation flow; it has no OTP setting.
# Optional public frontend origin used to build links to known student routes.
APP_NAME=Police Bharti Platform
FRONTEND_BASE_URL=

# Direct video uploads are stored under backend/uploads/videos by default.
# VIDEO_UPLOAD_DIRECTORY optionally overrides only the video subdirectory.
MAX_VIDEO_SIZE_MB=200
VIDEO_UPLOAD_DIRECTORY=

# Defaults: study/PYQ PDFs 20 MiB, Current Affairs images/team photos 5 MiB.
STUDY_MATERIAL_MAX_FILE_SIZE=20971520
PREVIOUS_YEAR_PDF_MAX_FILE_SIZE=20971520
CURRENT_AFFAIR_IMAGE_MAX_FILE_SIZE=5242880
TEAM_MEMBER_PHOTO_MAX_FILE_SIZE=5242880

# Topic-performance thresholds used by student performance summaries.
PERFORMANCE_STRONG_ACCURACY_THRESHOLD=75
PERFORMANCE_MIN_TOPIC_QUESTIONS=5
