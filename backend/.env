# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=DEBUG

# ==========================================
# SWAGGER API DOCUMENTATION
# ==========================================
# Development only
SWAGGER_ENABLED=True

# ==========================================
# CORS
# ==========================================
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_PROXY_HOPS=0

# ==========================================
# FILE AND MEDIA STORAGE
# ==========================================
# Blank means the application's configured default directory.
UPLOAD_ROOT=
VIDEO_UPLOAD_DIRECTORY=

MAX_VIDEO_SIZE_MB=200
STUDY_MATERIAL_MAX_FILE_SIZE=20971520
PREVIOUS_YEAR_PDF_MAX_FILE_SIZE=20971520
CURRENT_AFFAIR_IMAGE_MAX_FILE_SIZE=5242880
TEAM_MEMBER_PHOTO_MAX_FILE_SIZE=5242880

# Local filesystem remains the default.
# Do not configure R2 while we have paused that setup.

# ==========================================
# EMAIL
# ==========================================
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_FROM=
MAIL_TIMEOUT=10

# ==========================================
# APPLICATION LINKS
# ==========================================
FRONTEND_BASE_URL=http://localhost:5173

# ==========================================
# REGISTRATION
# ==========================================
# Existing direct registration flow; no OTP provider configured.

# ==========================================
# STUDENT PERFORMANCE
# ==========================================
